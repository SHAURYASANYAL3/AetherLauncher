<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Game Viewport Simulation / Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/game_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINECRAFT 1.20.4"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/game_engine_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Running on Zink Vulkan 1.3 | Sodium &amp; Lithium Active"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/game_live_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120.0 FPS"
            android:textColor="@color/accent_emerald"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/game_frame_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frametime: 8.33 ms (Smooth Pacing)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btn_exit_game"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="PAUSE &amp; EXIT TO LAUNCHER"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <!-- Top Overlay Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="12dp"
        android:text="Aether Multi-GPU Engine: ACTIVE"
        android:textColor="@color/accent_emerald"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#99000000"
        android:padding="6dp" />

</RelativeLayout>
